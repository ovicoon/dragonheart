{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragonheart",
  "main": "src/index.js",
  "compatibility_date": "2026-07-04",
  "observability": {
    "enabled": true
  },
  
  // D1 데이터베이스 바인딩
  "d1_databases": [
    {
      "binding": "selement",
      "database_name": "selement",
      "database_id": "1f4c9e4f-0ee8-4574-bdd6-8cb4ef4b4aeb"
    }
  ],

  "ratelimits": [
    {
      "name": "MY_RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}